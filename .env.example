# ─── Anthropic (Claude) — required for supervisor decisions ───────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── TTS Backend ──────────────────────────────────────────────────────────────
# "espeak"     — espeak-ng offline TTS, FREE (default, no internet/key needed)
#                Install: sudo apt install espeak-ng ffmpeg
# "gtts"       — Google TTS, FREE (needs internet, no key, supports Tamil)
# "edge-tts"   — Microsoft Edge TTS, FREE (needs internet, high quality Tamil)
# "elevenlabs" — ElevenLabs paid API
TTS_BACKEND=espeak

# ElevenLabs (only needed when TTS_BACKEND=elevenlabs)
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # default: Rachel (English)
# ELEVENLABS_VOICE_ID_TA=                      # Tamil voice ID
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ─── Image Backend ────────────────────────────────────────────────────────────
# "huggingface" — HuggingFace Inference API, FREE (default)
# "dalle"       — OpenAI DALL-E 3 (paid)
# "stability"   — Stability AI (paid)
IMAGE_BACKEND=huggingface

# HuggingFace (free; token optional but increases rate limits)
# Get a free token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# OpenAI DALL-E 3 (only needed when IMAGE_BACKEND=dalle)
# OPENAI_API_KEY=sk-...

# Stability AI (only needed when IMAGE_BACKEND=stability)
# STABILITY_API_KEY=

# ─── Video Backend ────────────────────────────────────────────────────────────
# "none"   — static images + MoviePy (FREE, default)
# "runway" — Runway Gen-3 animation (paid)
VIDEO_BACKEND=none

# Runway (only needed when VIDEO_BACKEND=runway)
# RUNWAY_API_KEY=
# RUNWAY_API_BASE=https://api.dev.runwayml.com/v1

# ─── Claude model ─────────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-opus-4-5

# ─── Output ───────────────────────────────────────────────────────────────────
OUTPUT_DIR=output
WATERMARK_TEXT=PREVIEW — NOT FOR DISTRIBUTION

# ─── Video resolution ─────────────────────────────────────────────────────────
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080

# ─── FFmpeg ───────────────────────────────────────────────────────────────────
# Leave blank if ffmpeg is on your PATH
FFMPEG_PATH=
