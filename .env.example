# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── ElevenLabs TTS ───────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # default: Rachel
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ─── OpenAI (DALL-E 3) ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Stability AI (optional alternative image backend) ────────────────────────
STABILITY_API_KEY=

# ─── Runway (video animation from images) ─────────────────────────────────────
RUNWAY_API_KEY=
RUNWAY_API_BASE=https://api.dev.runwayml.com/v1

# ─── Backends ─────────────────────────────────────────────────────────────────
# Image generation backend: "dalle" | "stability"
IMAGE_BACKEND=dalle

# Video animation backend: "runway" | "none"  (none = static images only)
VIDEO_BACKEND=runway

# ─── Claude model ─────────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-opus-4-5

# ─── Output ───────────────────────────────────────────────────────────────────
OUTPUT_DIR=output
WATERMARK_TEXT=PREVIEW — NOT FOR DISTRIBUTION

# ─── FFmpeg ───────────────────────────────────────────────────────────────────
# Leave blank if ffmpeg is on your PATH
FFMPEG_PATH=
