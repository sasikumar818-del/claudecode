# ── Video Production Studio — Fully Local Mode ───────────────────────────────
# Copy this to .env and fill in any required values.
#
# In fully local mode, no cloud API keys are required.
# Set all four USE_LOCAL_* flags to true and ensure the services below are running.

# ── Cloud API keys (leave blank / set to "local" if using all local plugins) ──
ANTHROPIC_API_KEY=local
ELEVENLABS_API_KEY=local
OPENAI_API_KEY=local

# ── Enable local processing ───────────────────────────────────────────────────
USE_LOCAL_LLM=true         # Script Writer: Ollama  (replaces Anthropic)
USE_LOCAL_TTS=true         # Voiceover:     pyttsx3 (replaces ElevenLabs)
USE_LOCAL_IMAGE=true       # Images:        Stable Diffusion (replaces DALL-E)
USE_LOCAL_VIDEO=true       # Video clips:   Ken Burns effect (replaces Runway)

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
# Start Ollama: ollama serve
# Pull a model: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Local TTS ─────────────────────────────────────────────────────────────────
LOCAL_TTS_RATE=150         # words per minute

# ── Stable Diffusion ──────────────────────────────────────────────────────────
SD_MODEL_ID=runwayml/stable-diffusion-v1-5
SD_DEVICE=auto             # auto | cuda | mps | cpu
SD_STEPS=20
SD_GUIDANCE_SCALE=7.5

# ── Gemini (cloud LLM alternative to Ollama) ─────────────────────────────────
# Replaces the Anthropic script writer. Get a key at https://aistudio.google.com
USE_GEMINI_LLM=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── ImaginePro (cloud image + video generation) ───────────────────────────────
# Replaces Stable Diffusion (images) and/or Ken Burns (video clips).
# Get a key at https://imaginepro.ai
USE_IMAGINEPRO_IMAGE=false
USE_IMAGINEPRO_VIDEO=false
IMAGINEPRO_API_KEY=
IMAGINEPRO_API_BASE=https://api.imaginepro.ai/api/v1

# ── Studio service ────────────────────────────────────────────────────────────
STUDIO_HOST=0.0.0.0
STUDIO_PORT=8000
STUDIO_DB_PATH=studio.db

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=output
WATERMARK_TEXT=PREVIEW — NOT FOR DISTRIBUTION
